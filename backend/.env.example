# ------------------------------------------------------------------
# Modele de configuration — CESIZen (backend)
#
# Copiez ce fichier en « .env » puis renseignez vos propres valeurs.
# Le fichier .env reel ne doit JAMAIS etre commite (voir .gitignore).
# En production, ces valeurs sont fournies via des secrets (GitHub Secrets).
# ------------------------------------------------------------------

# Port d'ecoute du serveur backend
PORT=3000

# --- Base de donnees PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=votre_utilisateur_db
DB_PASSWORD=votre_mot_de_passe_db
DB_NAME=cesizen

# --- Securite / Authentification ---
# Chaine aleatoire longue et unique. Generez-la, par exemple, avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue

# Nom de l'en-tete HTTP portant le token d'authentification
TOKEN_HEADER_KEY=token
