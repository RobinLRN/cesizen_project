# Variables d'environnement de l'environnement Docker (docker-compose)
# Copiez ce fichier en « .env » et renseignez de vraies valeurs.
# Le .env réel n'est JAMAIS commité (voir .gitignore).

#DB
DB_USER=cesizen_app
DB_PASSWORD=remplacez_par_un_mot_de_passe_fort
DB_NAME=cesizen

#Backend
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue
TOKEN_HEADER_KEY=token

#GitHub
GITHUB_TOKEN=votre_token_github
GITHUB_REPO=RobinLRN/cesizen_project
